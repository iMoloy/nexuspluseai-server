# NexusPulse AI Server Environment Variables Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development

# Database & Cache Configurations
MONGODB_URI=mongodb://127.0.0.1:27017/nexuspulse_db
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Security Keys
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_min_32_chars
CORS_ORIGIN=http://localhost:3000

# Third-Party API Integrations
GEMINI_API_KEY=AIzaSyYourDummyGeminiApiKeyHere
IMGBB_API_KEY=your_dummy_imgbb_api_key_here
STRIPE_SECRET_KEY=sk_test_51YourDummyStripeSecretKeyHere
GOOGLE_CLIENT_ID=your_dummy_google_client_id_here

